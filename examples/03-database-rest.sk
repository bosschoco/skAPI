# ─────────────────────────────────────────────
#  skAPI 예제 3 - DB REST API 로 데이터 입력 / 조회 / 삭제
#  (예시 주소 https://db.example.com 은 본인의 API 서버 주소로 바꾸세요)
# ─────────────────────────────────────────────

# options 값은 글자 그대로 붙여넣어지므로, 문자열 안에서 {@db} 처럼 쓸 값은 따옴표 없이 적습니다.
options:
	db: https://db.example.com/api
	db-token: 여기에-토큰

# 공통 헤더를 붙여주는 함수
function dbRequest(method: text, path: text) :: apirequest:
	set {_req} to new api request to "{@db}%{_path}%" with method {_method}
	set api header "Authorization" of {_req} to "Bearer {@db-token}"
	return {_req}

# ── 입력 (POST) ───────────────────────────────
on join:
	set {_user::uuid} to uuid of player
	set {_user::name} to name of player
	set {_user::joined} to now
	set {_req} to dbRequest("POST", "/players")
	set api body of {_req} to json of {_user::*}

	# 응답이 필요 없으면 백그라운드로 보내기만 해도 됩니다.
	send {_req} asynchronously

# ── 조회 (GET) ────────────────────────────────
command /profile [<offline player>]:
	trigger:
		set {_target} to arg-1 ? player
		set {_req} to dbRequest("GET", "/players/%uuid of {_target}%")

		send {_req} and store the response in {_res}

		if api status of {_res} is 404:
			send "&c등록되지 않은 플레이어입니다." to player
			stop
		if {_res} is not successful:
			send "&c조회 실패 (%api status of {_res}% %api error of {_res}%)" to player
			stop

		# JSON 을 목록 변수로 펼쳐서 사용
		load json {_res} into {_data::*}
		send "&e%{_data::name}% &7님의 정보" to player
		send "&7 - 레벨: %{_data::level}%" to player
		send "&7 - 가입일: %{_data::joined}%" to player
		loop {_data::badges::*}:
			send "&7 - 뱃지: %loop-value%" to player

# ── 목록 조회 (쿼리 파라미터) ─────────────────
command /ranking [<integer=1>]:
	trigger:
		set {_req} to dbRequest("GET", "/ranking")
		set api query "page" of {_req} to arg-1
		set api query "size" of {_req} to 10

		send {_req} and store the response in {_res}

		set {_names::*} to json values "items[*]" of {_res}
		set {_i} to 0
		loop {_names::*}:
			add 1 to {_i}
			send "&6%{_i}%위 &f%json value "name" of loop-value% &7(%json value "score" of loop-value%점)" to player

# ── 삭제 (DELETE) ─────────────────────────────
command /resetprofile:
	permission: op
	trigger:
		set {_req} to dbRequest("DELETE", "/players/%uuid of player%")
		send {_req} and store the response in {_res}
		if {_res} is successful:
			send "&a삭제되었습니다." to player
		else:
			send "&c삭제 실패: %api status of {_res}%" to player
