# ─────────────────────────────────────────────
#  skAPI 예제 1 - 기본 사용법 (비동기 = 권장)
#  명령어: /apitest
# ─────────────────────────────────────────────

command /apitest:
	trigger:
		set {_req} to new api request to "https://httpbin.org/get"
		set api query "name" of {_req} to name of player
		set api header "Accept" of {_req} to "application/json"

		# ★ 비동기(권장): 서버는 멈추지 않고, 응답이 오면 다음 줄부터 이어서 실행됩니다.
		#   {_req} 같은 로컬 변수와 player 가 그대로 살아있습니다.
		send {_req} and store the response in {_res}

		if {_res} is successful:
			send "&a성공! 상태 코드 %api status of {_res}%" to player
			send "&7보낸 이름: %json value "args.name" of {_res}%" to player
			send "&7걸린 시간: %api response time of {_res}%" to player
		else if api error of {_res} is set:
			# 연결 실패, 시간 초과 등 네트워크 오류
			send "&c요청 실패: %api error of {_res}%" to player
		else:
			# 서버가 4xx / 5xx 로 응답
			send "&c서버 오류: %api status of {_res}%" to player
