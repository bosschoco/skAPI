# ─────────────────────────────────────────────
#  skAPI 예제 2 - AI 에게 질문하기 (Claude API)
#  명령어: /ai <질문>
#
#  AI 답변은 몇 초 이상 걸릴 수 있으므로 반드시 비동기로 보내세요.
#  비동기로 보내도 {_player}, {_question} 같은 로컬 변수는 그대로 유지되므로
#  답변이 왔을 때 질문한 플레이어에게 정확히 돌려줄 수 있습니다.
#
#  ※ API 키는 플레이어에게 절대 보이지 않게 하고, 서버 파일 접근 권한을 관리하세요.
#  ※ options 값은 글자 그대로 붙여넣어지므로 따옴표 없이 적고, 쓸 때 "{@이름}" 처럼 씁니다.
# ─────────────────────────────────────────────

options:
	api-key: 여기에-API-키
	# 사용할 모델. 다른 모델을 쓰려면 이 값만 바꾸면 됩니다.
	model: claude-opus-5-5

command /ai <text>:
	cooldown: 5 seconds
	cooldown message: &c잠시 후 다시 질문해주세요.
	trigger:
		set {_player} to player
		set {_question} to arg-1
		send "&7[AI] 생각 중..." to {_player}

		# 요청 본문을 목록 변수로 만들고 json of 로 변환 (따옴표/줄바꿈 이스케이프 자동 처리)
		set {_body::model} to "{@model}"
		set {_body::max_tokens} to 4096
		set {_body::system} to "너는 마인크래프트 서버의 도우미야. 한국어로 3문장 이내로 짧게 답해."
		set {_body::messages::1::role} to "user"
		set {_body::messages::1::content} to {_question}
		# 채팅 답변은 빠른 게 중요하므로 effort 를 low 로 설정
		set {_body::output_config::effort} to "low"
		# 안전 필터로 거절되면 다른 모델로 자동 재시도 (아래 anthropic-beta 헤더와 세트)
		set {_body::fallbacks} to "default"

		set {_req} to new post api request to "https://api.anthropic.com/v1/messages" with body json of {_body::*}
		set api header "x-api-key" of {_req} to "{@api-key}"
		set api header "anthropic-version" of {_req} to "2023-06-01"
		set api header "anthropic-beta" of {_req} to "server-side-fallback-2026-07-01"
		set api timeout of {_req} to 90 seconds

		# ★ 비동기 대기형 - 응답이 올 때까지 이 트리거만 잠시 멈추고 서버는 계속 돌아갑니다.
		send {_req} and store the response in {_res}

		# 여기부터는 응답이 도착한 뒤 메인 스레드에서 실행됩니다. {_player}, {_question} 그대로 사용 가능.
		if api error of {_res} is set:
			send "&c[AI] 연결 실패: %api error of {_res}%" to {_player}
			stop
		if {_res} is not successful:
			send "&c[AI] 오류 %api status of {_res}%: %json value "error.message" of {_res}%" to {_player}
			stop
		if json value "stop_reason" of {_res} is "refusal":
			send "&c[AI] 이 질문에는 답변할 수 없어요." to {_player}
			stop

		# content 배열에서 type 이 text 인 블록의 text 를 꺼낸다
		set {_answer} to json value "content[type=text].text" of {_res}
		send "&b[AI] &f%{_answer}%" to {_player}
